{
  "name": "vaultr-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend assets for Vaultr: Tabler and htmx.",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('vaultr/static',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build:css": "copyfiles -f node_modules/@tabler/core/dist/css/tabler.min.css assets/custom.css vaultr/static/css",
    "build:js": "copyfiles -f node_modules/@tabler/core/dist/js/tabler-theme.min.js node_modules/htmx.org/dist/htmx.min.js assets/app.js vaultr/static/js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tabler/core": "^1.5.0",
    "copyfiles": "^2.4.1",
    "htmx.org": "^2.0.4"
  }
}
