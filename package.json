{
  "name": "vaultr-assets",
  "version": "1.1.2",
  "private": true,
  "description": "Frontend assets for Vaultr: Tabler, htmx and Swagger UI.",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('vaultr/static',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build:css": "copyfiles -f node_modules/@tabler/core/dist/css/tabler.min.css node_modules/swagger-ui-dist/swagger-ui.css assets/custom.css vaultr/static/css",
    "build:js": "copyfiles -f node_modules/@tabler/core/dist/js/tabler-theme.min.js node_modules/htmx.org/dist/htmx.min.js node_modules/swagger-ui-dist/swagger-ui-bundle.js assets/app.js assets/swagger-init.js vaultr/static/js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tabler/core": "^1.7.3",
    "copyfiles": "^2.4.1",
    "htmx.org": "^4.0.1",
    "swagger-ui-dist": "5.33.3"
  }
}
