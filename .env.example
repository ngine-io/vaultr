# Copy to .env for local development. Never commit the real file.

VAULTR_APP_NAME=Vaultr
VAULTR_CONFIG_FILE=config.yml
VAULTR_LOG_LEVEL=INFO
VAULTR_LOG_JSON=false

# Comma separated bearer tokens for the API and the UI. Empty disables auth.
VAULTR_API_TOKENS=

# Project passphrases referenced by config.yml via passphrase_env.
VAULTR_PASSPHRASE_PROD=change-me-prod
VAULTR_PASSPHRASE_TEST=change-me-test
